load("@apt_fixture//:architecture.bzl", "ARCHITECTURE")
load("@rules_distroless//apt:defs.bzl", "apt_install")

_BSDTAR = "@bsd_tar_toolchains_linux_%s//:tar" % ARCHITECTURE

# The isolation executable is a declared input, not whichever bwrap happens
# to be installed on the execution host. BSD tar only reads the original DEB.
genrule(
    name = "bubblewrap",
    srcs = ["@apt_fixture//:bubblewrap.deb"],
    outs = ["bwrap"],
    cmd = "$(location %s) -xOf $(location @apt_fixture//:bubblewrap.deb) data.tar.xz | $(location %s) -xOf - ./usr/bin/bwrap >$@; chmod 0755 $@" % (_BSDTAR, _BSDTAR),
    executable = True,
    tools = [_BSDTAR],
)

apt_install(
    name = "configured",
    architecture = ARCHITECTURE,
    base = "@apt_fixture//:base.tar.gz",
    bwrap = ":bubblewrap",
    execution_environment = "debian:trixie-20260918@sha256:9cc080028c43b27d2074d63a5f9caf7166d731494965616c1a6d2827a004585c",
    packages = ["@apt_fixture//:%s.deb" % name for name in [
        "adduser",
        "ca-certificates",
        "less",
        "libpcre2-16-0",
        "openssl",
        "systemd-standalone-sysusers",
        "systemd-standalone-tmpfiles",
        "uuid-runtime",
        "vim-common",
        "vim-tiny",
    ]],
)

filegroup(
    name = "configuration_receipt",
    srcs = [":configured"],
    output_group = "receipt",
)

filegroup(
    name = "transaction_packages",
    srcs = [
        "@apt_fixture//:hello-0.deb",
        "@apt_fixture//:hello-1.deb",
    ],
)
